# Garvis environment variables. Copy this file to .env and fill in the values.
# Never commit .env — it's in .gitignore.

# ---------------------------------------------------------------------------
# Picovoice Porcupine (wake word detection)
# Get a free personal access key at: https://console.picovoice.ai/
# Phase 0 does NOT need this. Phase 2 does.
# ---------------------------------------------------------------------------
PICOVOICE_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Google Gemini (fast brain for simple questions)
# Free tier is generous — https://aistudio.google.com/apikey
# You said you already have this one.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Claude (heavy brain for computer control + planning)
# Uses the `claude -p` CLI with your Claude Pro/Max subscription.
# No API key needed here — just make sure `claude` is installed:
#   npm install -g @anthropic-ai/claude-code
# You can override the binary location below if `claude` isn't on your PATH.
# ---------------------------------------------------------------------------
CLAUDE_BIN=claude
